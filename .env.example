# Database Configuration - Supabase (PostgreSQL)
# DATABASE_URL: Transaction pooler URL (mode=transaction)
# DIRECT_URL: Session pooler URL (mode=session) or direct connection for migrations
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.cvfkgzwhkjwzweoqxcpb.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret (generate a strong random key in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Node Environment
NODE_ENV="development"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3002"
